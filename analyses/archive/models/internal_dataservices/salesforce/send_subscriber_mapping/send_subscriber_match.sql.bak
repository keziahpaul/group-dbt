{{
    config(
        materialized='incremental',
        unique_key='registration_id',
        merge_exclude_columns = ['inserted_at'],
        on_schema_change='append_new_columns'
    )
}}

with
{% if is_incremental() %}
target_max_timestamp as 
(
    select max(src_delta_extract_ts) as last_load_max_timestamp from {{ this }}
)
,
{% endif %}

send_sub_match as (
    select
        s.abn_acn,
        s.affiliate_branch,
        s.affiliate_employee,
        s.business_name,
        s.day_of_lead_created_date_aest,
        s.day_of_registration_date_aest,
        s.domain_email_address,
        s.full_name,
        s.master_registration_id,
        s.purpose,
        s.registration_account_manager,
        s.registration_account_manager_email,
        s.registration_created_source,
        s.registration_id,
        s.state,
        s.max_trade_settled_for_accounting_date,
        s.min_trade_settled_for_accounting_date,
        s.registrations_pexa_opt_in_date_aest,
        s.registrations_pexa_opt_in_flag,
        s.subscriber_id,
        s.match_method,
        s.subscriber_status,
        CONVERT_TIMEZONE('Australia/Sydney', s.inserted_at) as src_delta_extract_ts,
        CONVERT_TIMEZONE('Australia/Sydney', CURRENT_TIMESTAMP(2)) as inserted_at,
        CONVERT_TIMEZONE('Australia/Sydney', CURRENT_TIMESTAMP(2)) as updated_at
    from {{ ref('send_subscriber_match_process') }} as s
    where LOWER(s.match_method) not in ('duplicate registrations', 'duplicate subscribers', 'no_match', 'new registration for existing subscriber', 'referral', 'cannot match', 'orphan')
        and LOWER(s.match_method) not like ('duplicate%')
    {% if is_incremental() %}
        -- this filter will only be applied on an incremental run
        and s.updated_at > (select last_load_max_timestamp from target_max_timestamp ) 
    {% endif %}
)

select * from send_sub_match
